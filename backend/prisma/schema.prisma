// ─── Prisma Schema ─────────────────────────────────────────────────────────
// Smart Grocery Planner & QR Pickup System
//
// This is the skeleton schema for Phase 1.
// Full entity definitions are implemented in Phase 2 (Prisma Data Model).
//
// Prisma 7 / Client 7 configuration:
// The datasource `url` has been moved to `prisma.config.ts` (Prisma CLI config)
// and the PrismaClient now receives a driver adapter. See src/lib/db.ts.
//
// Do NOT run `prisma migrate dev` until DATABASE_URL is configured and
// the Phase 2 entity design has been reviewed and approved.
// ───────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

